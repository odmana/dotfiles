# Plain zsh: no framework. Plugins come from Homebrew (macOS) or apt (Linux);
# the prompt is Starship (~/.config/starship.toml, linked from dotfiles/starship).

##############################################################
# Paths
##############################################################
export DOTFILES_DIR="$HOME/dotfiles"
export PATH="$HOME/bin:$DOTFILES_DIR/bin:/usr/local/bin:/usr/local/share/dotnet:$PATH"
typeset -U path  # drop duplicate PATH entries

# Where Homebrew (set by `brew shellenv` in ~/.zprofile) or the distro puts zsh plugins
if [[ -n $HOMEBREW_PREFIX ]]; then
  plugin_dirs=("$HOMEBREW_PREFIX/share")
else
  plugin_dirs=(/usr/share /usr/share/zsh/plugins)
fi
# Source the first <dir>/<name>/<name>.zsh that exists
load_plugin() {
  local d
  for d in $plugin_dirs; do
    [[ -r $d/$1/$1.zsh ]] && { source "$d/$1/$1.zsh"; return; }
  done
}

##############################################################
# History
##############################################################
HISTFILE="$HOME/.zsh_history"
HISTSIZE=1000000000
SAVEHIST=$HISTSIZE
setopt EXTENDED_HISTORY        # save timestamps
setopt SHARE_HISTORY           # share history between open shells
setopt HIST_IGNORE_DUPS        # don't save a command repeated back to back
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_SPACE       # commands starting with a space (e.g. ones containing secrets) aren't saved
setopt HIST_VERIFY             # show !! expansions before running them

##############################################################
# Shell options
##############################################################
setopt AUTO_CD                 # type a directory name to cd into it
setopt AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT
setopt INTERACTIVE_COMMENTS
WORDCHARS=''                   # Alt-arrow / Ctrl-W stop at punctuation, e.g. path segments

##############################################################
# Completion
##############################################################
[[ -n $HOMEBREW_PREFIX ]] && fpath=("$HOMEBREW_PREFIX/share/zsh-completions" "$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
autoload -Uz compinit && compinit
zmodload zsh/complist
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'  # case-insensitive, then partial-word
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

##############################################################
# Key bindings
##############################################################
bindkey -e
# Up/Down search history for commands starting with what's typed so far
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search
bindkey '^[[3~' delete-char
bindkey '^[[Z' reverse-menu-complete   # Shift-Tab
# Word / line movement for whatever Home/End/Alt-arrow encoding the
# terminal or multiplexer (herdr) passes through
bindkey '^[[H' beginning-of-line
bindkey '^[OH' beginning-of-line
bindkey '^[[1~' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[OF' end-of-line
bindkey '^[[4~' end-of-line
bindkey '^[[1;3D' backward-word
bindkey '^[[1;3C' forward-word

##############################################################
# Aliases
##############################################################
export CLICOLOR=1                                 # coloured ls on macOS
[[ $OSTYPE == linux* ]] && alias ls='ls --color=auto'
alias l='ls -lah'
alias ll='ls -lh'
alias la='ls -lAh'
alias g='git'

##############################################################
# Tools
##############################################################
[ -s "$HOME/.nix-profile/etc/profile.d/nix.sh" ] && . "$HOME/.nix-profile/etc/profile.d/nix.sh"

# fzf: Ctrl-R history, Ctrl-T files, Alt-C directories
if fzf --zsh >/dev/null 2>&1; then
  source <(fzf --zsh)
elif [[ -r /usr/share/doc/fzf/examples/key-bindings.zsh ]]; then  # older Debian/Ubuntu fzf
  source /usr/share/doc/fzf/examples/key-bindings.zsh
fi

command -v zoxide >/dev/null && eval "$(zoxide init zsh)"     # `z <part of a path>`
if command -v starship >/dev/null; then
  eval "$(starship init zsh)"
  ZLE_RPROMPT_INDENT=0  # right-hand frame (─╯) flush with the edge, under ─╮
  # Blank line before each prompt, except the first one in a new shell or after `clear`
  _prompt_spacing() { (( ${+_prompt_drawn} )) && print; _prompt_drawn=1 }
  _prompt_spacing_reset() { [[ $2 == (clear|reset)(| *) ]] && unset _prompt_drawn }
  precmd_functions+=(_prompt_spacing)
  preexec_functions+=(_prompt_spacing_reset)
fi

[ -s "$DOTFILES_DIR/config/aliases.sh" ] && . "$DOTFILES_DIR/config/aliases.sh"
[ -s "$DOTFILES_DIR/config/local.sh" ] && . "$DOTFILES_DIR/config/local.sh"

# Plugins last: syntax highlighting must wrap every widget defined above
load_plugin zsh-autosuggestions
load_plugin zsh-syntax-highlighting
unset plugin_dirs
unfunction load_plugin
